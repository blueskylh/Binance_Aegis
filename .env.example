# ─── Aegis configuration ──────────────────────────────────────────────────────
# Aegis holds NO Binance credentials. It authorizes actions; binance-cli executes
# them. These variables only tell Aegis where to find its policy and its ledger.

# Policy file. Start with policies/monitor-first.yaml, graduate to conservative.
AEGIS_POLICY=./policies/monitor-first.yaml

# Where ledger.jsonl and state.json live. Defaults to ~/.aegis
AEGIS_HOME=./.aegis

# Path to the Binance Agent OS CLI, if it is not on PATH.
# Install: curl --proto '=https' --tlsv1.2 -LsSf \
#   https://github.com/binance/binance-cli/releases/latest/download/binance-cli-installer.sh | sh
# AEGIS_BINANCE_CLI=binance-cli

# binance-cli profile, when several accounts are configured.
# BINANCE_CLI_PROFILE=agentic

# Disable ANSI colour in CLI output.
# NO_COLOR=1
